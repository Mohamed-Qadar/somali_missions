# Copy to .env and fill in real values before running docker-compose up.
# Never commit the real .env file.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-real-random-secret-key

DEBUG=False
ALLOWED_HOSTS=your-domain.gov.so,www.your-domain.gov.so

# Postgres (docker-compose builds DATABASE_URL from these automatically)
POSTGRES_DB=somali_missions
POSTGRES_USER=somali_missions
POSTGRES_PASSWORD=replace-with-a-real-password

# Only set to True once HTTPS is actually terminating in front of this app
# (via nginx+certbot, a load balancer, or a CDN). Enabling HSTS before TLS
# works can lock browsers out of the site over HTTP with no easy way back.
SECURE_SSL_ENABLED=False

# Email (defaults to printing to the console/log if left unset)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@your-domain.gov.so

# Error monitoring (optional - leave blank to disable Sentry entirely)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Metrics endpoint at /metrics/ (Prometheus text format) - set False to disable
METRICS_ENABLED=True

# CORS for the REST API (/api/...) only - comma-separated origins allowed to
# call the API from a browser (e.g. a future mobile web client). Leave blank
# if only native mobile apps (no browser CORS enforcement) will use the API.
CORS_ALLOWED_ORIGINS=

# Assistant provider - only 'rule_based' is implemented today (see
# assistant/providers.py). Placeholder for a future AI-backed provider.
ASSISTANT_PROVIDER=rule_based
